        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="elementsLabel">
          <property name="text"><string>Elements:</string></property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QCheckBox" name="showAnnotations">
          <property name="text"><string>Angle annotations</string></property>
          <property name="checked"><bool>true</bool></property>
         </widget>
        </item>
        <item row="2" column="1">
         <widget class="QCheckBox" name="showVectors">
          <property name="text"><string>Vectors</string></property>
          <property name="checked"><bool>true</bool></property>
         </widget>
        </item>
        <item row="3" column="0"><widget class="QLabel" name="vectorColorButtonLabel"><property name="text"><string>Vector color:</string></property></widget></item>
        <item row="3" column="1"><widget class="ctkColorPickerButton" name="vectorColorButton"><property name="color"><color><red>255</red><green>128</green><blue>0</blue></color></property></widget></item>
        <item row="4" column="0"><widget class="QLabel" name="pairTypesLabel"><property name="text"><string>Angle pairs:</string></property></widget></item>
        <item row="4" column="1"><widget class="QCheckBox" name="showParentChild"><property name="text"><string>Parent-child angles</string></property><property name="checked"><bool>true</bool></property></widget></item>
        <item row="5" column="1"><widget class="QCheckBox" name="showChildChild"><property name="text"><string>Child-child angles</string></property><property name="checked"><bool>true</bool></property></widget></item>
        <item row="6" column="0"><widget class="QLabel" name="branchOrdersLabel"><property name="text"><string>Branch orders:</string></property></widget></item>
        <item row="6" column="1"><widget class="QWidget" name="branchOrdersWidget"><layout class="QVBoxLayout" name="branchOrdersLayout"/></widget></item>
        <item row="7" column="0"><widget class="QLabel" name="interactionLabel"><property name="text"><string>Interaction:</string></property></widget></item>
        <item row="7" column="1"><widget class="QCheckBox" name="snapToCenterline"><property name="text"><string>Snap dragged vector endpoints to the centerline</string></property><property name="toolTip"><string>Keep a dragged bifurcation vector endpoint on the centerline the angles were computed from. Only the endpoint being dragged is moved.</string></property><property name="checked"><bool>true</bool></property></widget></item>
        <item row="8" column="1"><widget class="QPushButton" name="resetSelectedVectorButton"><property name="text"><string>Reset selected vector</string></property><property name="toolTip"><string>Restore the selected bifurcation vector to the endpoints generated from the centerline, and the angles measured from it with them.</string></property></widget></item>
       </layout>
