           <property name="leftMargin"><number>0</number></property>
           <property name="topMargin"><number>0</number></property>
           <property name="rightMargin"><number>0</number></property>
           <property name="bottomMargin"><number>0</number></property>
           <item>
            <widget class="QDoubleSpinBox" name="minimumAngleSpinBox">
             <property name="toolTip"><string>Hide angle annotations below this value. Angles equal to the threshold remain visible.</string></property>
             <property name="suffix"><string> degrees</string></property>
             <property name="maximum"><double>180.000000000000000</double></property>
             <property name="singleStep"><double>5.000000000000000</double></property>
             <property name="value"><double>60.000000000000000</double></property>
            </widget>
