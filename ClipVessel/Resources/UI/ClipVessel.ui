          <widget class="ctkSliderWidget" name="localSphereRadiusFactorWidget">
           <property name="toolTip">
            <string>Size of the local region (sphere/patch radius or box half-width) as a multiple of the vessel radius at each clip point.</string>
           </property>
           <property name="decimals">
            <number>1</number>
           </property>
           <property name="singleStep">
            <double>0.100000000000000</double>
