      <item row="2" column="1">
       <widget class="QCheckBox" name="remeshSurfaceCheckBox">
        <property name="toolTip">
         <string>Retriangulate the surface into near equilateral cells of the target edge length before it is filled. Turn this off to fill the surface as it arrived, which is only worth doing when it is already meshed the way the solver wants it: the size of the tetrahedra follows the size of the triangles they sit against.</string>
        </property>
        <property name="text">
         <string/>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>remeshSurface</string>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QCheckBox" name="capSurfaceCheckBox">
        <property name="toolTip">
         <string>Close every open boundary of the input surface with a cap of its own, each under its own id so that a boundary condition can be assigned to it. Turn this off for a surface that is already closed; a surface left open cannot be filled with tetrahedra at all.</string>
        </property>
        <property name="text">
         <string/>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
