         </item>
         <item row="9" column="1">
          <layout class="QHBoxLayout" name="outputRemeshedSurfaceRowLayout">
           <item>
            <widget class="qMRMLNodeComboBox" name="outputRemeshedSurfaceSelector">
             <property name="sizePolicy">
              <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
               <horstretch>1</horstretch>
               <verstretch>0</verstretch>
              </sizepolicy>
             </property>
             <property name="toolTip">
              <string>Optional. Model node the remeshed surface alone is written into, which is the surface the volume mesh was built on.</string>
             </property>
             <property name="nodeTypes">
              <stringlist notr="true">
               <string>vtkMRMLModelNode</string>
              </stringlist>
             </property>
             <property name="showChildNodeTypes">
              <bool>false</bool>
             </property>
             <property name="noneEnabled">
              <bool>true</bool>
             </property>
             <property name="addEnabled">
              <bool>true</bool>
             </property>
             <property name="removeEnabled">
              <bool>true</bool>
             </property>
             <property name="renameEnabled">
              <bool>true</bool>
             </property>
             <property name="SlicerParameterName" stdset="0">
              <string>outputRemeshedSurface</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QToolButton" name="outputRemeshedSurfaceEdgesButton">
             <property name="enabled">
              <bool>false</bool>
             </property>
             <property name="toolTip">
              <string>Show or hide the edges of the remeshed surface</string>
             </property>
             <property name="text">
              <string/>
             </property>
             <property name="toolButtonStyle">
              <enum>Qt::ToolButtonIconOnly</enum>
             </property>
             <property name="autoRaise">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QToolButton" name="outputRemeshedSurfaceVisibilityButton">
             <property name="enabled">
              <bool>false</bool>
             </property>
             <property name="toolTip">
              <string>Show or hide the remeshed surface</string>
             </property>
             <property name="text">
              <string/>
             </property>
             <property name="toolButtonStyle">
              <enum>Qt::ToolButtonIconOnly</enum>
             </property>
             <property name="autoRaise">
              <bool>true</bool>
             </property>
            </widget>
           </item>
          </layout>
         </item>
        </layout>
       </widget>
      </item>
      <item row="6" column="0" colspan="2">
       <widget class="ctkCollapsibleGroupBox" name="CollapsibleGroupBox">
        <property name="title">
         <string>Boundary layer</string>
        </property>
        <property name="collapsed">
         <bool>true</bool>
        </property>
        <layout class="QFormLayout" name="formLayout_2">
         <item row="0" column="0">
          <widget class="QLabel" name="boundaryLayerOnCapsLabel">
           <property name="text">
            <string>Layer on caps:</string>
           </property>
           <property name="indent">
            <number>10</number>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QCheckBox" name="boundaryLayerOnCapsCheckBox">
           <property name="toolTip">
            <string>Grow the boundary layer over the caps as well as over the wall. Turn this off to keep each cap a single flat face with the flow meeting it directly, which is what an inlet or outlet boundary condition wants; the caps are then made past the layer, on the inner surface. A surface that arrives already capped has its caps taken off first and their ids put back on the ones made in their place, so this means the same thing whether or not the ends were closed before.</string>
           </property>
           <property name="text">
            <string/>
           </property>
           <property name="SlicerParameterName" stdset="0">
            <string>boundaryLayerOnCaps</string>
           </property>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="numberOfSubLayersLabel">
           <property name="text">
            <string>Number of sublayers:</string>
           </property>
           <property name="indent">
            <number>10</number>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="QSpinBox" name="numberOfSubLayersSpinBox">
           <property name="toolTip">
            <string>Number of layers of prisms the boundary layer is made of.</string>
           </property>
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>100</number>
           </property>
           <property name="value">
            <number>2</number>
           </property>
           <property name="SlicerParameterName" stdset="0">
            <string>numberOfSubLayers</string>
           </property>
          </widget>
         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="subLayerRatioLabel">
           <property name="text">
            <string>Sublayer ratio:</string>
           </property>
           <property name="indent">
            <number>10</number>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="QDoubleSpinBox" name="subLayerRatioSpinBox">
           <property name="toolTip">
            <string>Thickness of each layer over the thickness of the one outside it. Below 1 the layers get thinner towards the wall, which is where the gradient is steepest.</string>
           </property>
           <property name="decimals">
            <number>2</number>
           </property>
           <property name="minimum">
            <double>0.010000000000000</double>
           </property>
           <property name="maximum">
            <double>10.000000000000000</double>
           </property>
           <property name="singleStep">
            <double>0.050000000000000</double>
           </property>
           <property name="value">
            <double>0.500000000000000</double>
           </property>
           <property name="SlicerParameterName" stdset="0">
            <string>subLayerRatio</string>
           </property>
          </widget>
         </item>
         <item row="3" column="0">
          <widget class="QLabel" name="boundaryLayerThicknessFactorLabel">
           <property name="text">
            <string>Thickness factor:</string>
           </property>
           <property name="indent">
            <number>10</number>
           </property>
          </widget>
         </item>
         <item row="3" column="1">
          <widget class="QDoubleSpinBox" name="boundaryLayerThicknessFactorSpinBox">
           <property name="toolTip">
            <string>Total thickness of the boundary layer, as a fraction of the target edge length.</string>
           </property>
           <property name="decimals">
            <number>2</number>
           </property>
           <property name="minimum">
            <double>0.010000000000000</double>
           </property>
           <property name="maximum">
            <double>10.000000000000000</double>
           </property>
           <property name="singleStep">
            <double>0.050000000000000</double>
           </property>
           <property name="value">
            <double>0.250000000000000</double>
           </property>
           <property name="SlicerParameterName" stdset="0">
            <string>boundaryLayerThicknessFactor</string>
           </property>
          </widget>
         </item>
         <item row="4" column="0">
          <widget class="QLabel" name="endcapsEdgeLengthFactorLabel">
           <property name="text">
            <string>Endcaps edge length factor:</string>
           </property>
           <property name="indent">
            <number>10</number>
           </property>
          </widget>
         </item>
         <item row="4" column="1">
          <widget class="QDoubleSpinBox" name="endcapsEdgeLengthFactorSpinBox">
           <property name="toolTip">
            <string>Multiplies the target edge length for the caps. It is only read when the boundary layer stops short of the caps, because those caps are the only ones remeshed on their own.</string>
           </property>
           <property name="decimals">
            <number>2</number>
           </property>
           <property name="minimum">
            <double>0.010000000000000</double>
           </property>
           <property name="maximum">
            <double>100.000000000000000</double>
           </property>
           <property name="singleStep">
            <double>0.100000000000000</double>
           </property>
           <property name="value">
            <double>1.000000000000000</double>
           </property>
           <property name="SlicerParameterName" stdset="0">
            <string>endcapsEdgeLengthFactor</string>
           </property>
          </widget>
         </item>
         <item row="5" column="0">
          <widget class="QLabel" name="numberOfSubstepsLabel">
           <property name="text">
            <string>Number of substeps:</string>
           </property>
           <property name="indent">
            <number>10</number>
           </property>
          </widget>
         </item>
         <item row="5" column="1">
          <widget class="QSpinBox" name="numberOfSubstepsSpinBox">
           <property name="toolTip">
            <string>Steps the inner surface is marched inwards in. More of them let it get around a tight corner without folding over itself, at the cost of time.</string>
           </property>
           <property name="minimum">
            <number>100</number>
           </property>
           <property name="maximum">
            <number>1000000</number>
           </property>
           <property name="value">
            <number>2000</number>
           </property>
           <property name="SlicerParameterName" stdset="0">
            <string>numberOfSubsteps</string>
           </property>
          </widget>
         </item>
         <item row="6" column="0">
          <widget class="QLabel" name="relaxationLabel">
           <property name="text">
            <string>Relaxation:</string>
           </property>
           <property name="indent">
            <number>10</number>
           </property>
          </widget>
         </item>
         <item row="6" column="1">
          <widget class="QDoubleSpinBox" name="relaxationSpinBox">
           <property name="toolTip">
            <string>How far the inner surface is allowed to move per substep. Smaller values follow a difficult shape more closely and take longer.</string>
           </property>
           <property name="decimals">
            <number>3</number>
           </property>
           <property name="minimum">
            <double>0.001000000000000</double>
           </property>
           <property name="maximum">
            <double>1.000000000000000</double>
           </property>
           <property name="singleStep">
            <double>0.010000000000000</double>
           </property>
           <property name="value">
            <double>0.010000000000000</double>
           </property>
           <property name="SlicerParameterName" stdset="0">
            <string>relaxation</string>
           </property>
          </widget>
         </item>
         <item row="7" column="0">
          <widget class="QLabel" name="localCorrectionFactorLabel">
           <property name="text">
            <string>Local correction factor:</string>
           </property>
           <property name="indent">
            <number>10</number>
           </property>
          </widget>
         </item>
         <item row="7" column="1">
          <widget class="QDoubleSpinBox" name="localCorrectionFactorSpinBox">
           <property name="toolTip">
            <string>How strongly the direction a point is swept along is pulled back towards its neighbours where the layer starts to tangle, as it does on the inside of a tight bend.</string>
           </property>
           <property name="decimals">
            <number>2</number>
           </property>
           <property name="minimum">
            <double>0.000000000000000</double>
           </property>
           <property name="maximum">
            <double>1.000000000000000</double>
           </property>
           <property name="singleStep">
            <double>0.050000000000000</double>
           </property>
           <property name="value">
            <double>0.450000000000000</double>
           </property>
           <property name="SlicerParameterName" stdset="0">
            <string>localCorrectionFactor</string>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
      </item>
      <item row="7" column="0" colspan="2">
       <widget class="ctkCollapsibleGroupBox" name="CollapsibleGroupBox_2">
        <property name="title">
         <string>Volume mesh</string>
        </property>
        <property name="collapsed">
         <bool>true</bool>
        </property>
        <layout class="QFormLayout" name="formLayout_3">
         <item row="0" column="0">
          <widget class="QLabel" name="mesherLabel">
           <property name="text">
            <string>Mesher:</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QComboBox" name="mesherComboBox">
           <property name="toolTip">
            <string>Which mesher fills the surface. TetGen hands back the surface it was given with tetrahedra behind it, so the mesh meets the surface exactly, and a surface it cannot fill it fails on. fTetWild meshes the shape the surface describes, keeping within the surface tolerance of it, and answers where TetGen fails; it is also one that can size the elements by position. Netgen keeps the surface it is given like TetGen and sizes the elements by position like fTetWild, and gives up rather than crashing on a surface it cannot fill. fTetWild and Netgen are each downloaded the first time they are used.</string>
           </property>
           <property name="SlicerParameterName" stdset="0">
            <string>mesher</string>
           </property>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="surfaceToleranceLabel">
           <property name="text">
            <string>Surface tolerance:</string>
           </property>
           <property name="indent">
            <number>10</number>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="QDoubleSpinBox" name="surfaceToleranceSpinBox">
           <property name="toolTip">
            <string>How far the boundary of the mesh may sit from the surface it was made for, the caps included. Smaller follows the surface more closely and takes longer. The default is a thousandth of the size of the surface.</string>
           </property>
           <property name="suffix">
            <string> mm</string>
           </property>
           <property name="decimals">
            <number>3</number>
           </property>
           <property name="minimum">
            <double>0.000000000000000</double>
           </property>
           <property name="maximum">
            <double>100.000000000000000</double>
           </property>
           <property name="singleStep">
            <double>0.010000000000000</double>
           </property>
           <property name="value">
            <double>0.000000000000000</double>
           </property>
           <property name="specialValueText">
            <string>default</string>
           </property>
           <property name="SlicerParameterName" stdset="0">
            <string>surfaceTolerance</string>
           </property>
          </widget>
         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="stopEnergyLabel">
           <property name="text">
            <string>Stop energy:</string>
           </property>
           <property name="indent">
            <number>10</number>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="QDoubleSpinBox" name="stopEnergySpinBox">
           <property name="toolTip">
            <string>How good the worst element has to be before the mesher stops improving the mesh. 3 is a regular tetrahedron and there is no upper bound; below 8 a complicated surface can take a very long time.</string>
           </property>
           <property name="decimals">
            <number>1</number>
           </property>
           <property name="minimum">
            <double>3.000000000000000</double>
           </property>
           <property name="maximum">
            <double>1000.000000000000000</double>
           </property>
           <property name="singleStep">
            <double>1.000000000000000</double>
           </property>
           <property name="value">
            <double>10.000000000000000</double>
           </property>
           <property name="SlicerParameterName" stdset="0">
            <string>stopEnergy</string>
           </property>
          </widget>
         </item>
         <item row="3" column="0">
          <widget class="QLabel" name="maxOptimizationPassesLabel">
           <property name="text">
            <string>Optimization passes:</string>
           </property>
           <property name="indent">
            <number>10</number>
           </property>
          </widget>
         </item>
         <item row="3" column="1">
          <widget class="QSpinBox" name="maxOptimizationPassesSpinBox">
           <property name="toolTip">
            <string>How many passes the mesher may spend improving the mesh before it stops, whether or not it has reached the stop energy.</string>
           </property>
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>1000</number>
           </property>
           <property name="value">
            <number>80</number>
           </property>
           <property name="SlicerParameterName" stdset="0">
            <string>maxOptimizationPasses</string>
           </property>
          </widget>
         </item>
         <item row="4" column="0">
          <widget class="QLabel" name="coarsenLabel">
           <property name="text">
            <string>Coarsen:</string>
           </property>
           <property name="indent">
            <number>10</number>
           </property>
          </widget>
         </item>
         <item row="4" column="1">
          <widget class="QCheckBox" name="coarsenCheckBox">
           <property name="toolTip">
            <string>Make the mesh as coarse as the surface tolerance allows rather than as fine as asked for, which gives the fewest elements that still describe the shape.</string>
           </property>
           <property name="text">
            <string/>
           </property>
           <property name="SlicerParameterName" stdset="0">
            <string>coarsen</string>
           </property>
          </widget>
         </item>
         <item row="5" column="0">
          <widget class="QLabel" name="netgenGradingLabel">
           <property name="text">
            <string>Grading:</string>
           </property>
           <property name="indent">
            <number>10</number>
           </property>
          </widget>
         </item>
         <item row="5" column="1">
          <widget class="QDoubleSpinBox" name="netgenGradingSpinBox">
           <property name="toolTip">
            <string>How fast the tetrahedra may grow away from the surface: at 1 as fast as they can, and near 0 the whole volume is meshed at the size of the finest part of the surface. Netgen only.</string>
           </property>
           <property name="decimals">
            <number>2</number>
           </property>
           <property name="minimum">
            <double>0.010000000000000</double>
           </property>
           <property name="maximum">
            <double>1.000000000000000</double>
           </property>
           <property name="singleStep">
            <double>0.050000000000000</double>
           </property>
           <property name="value">
            <double>0.300000000000000</double>
           </property>
           <property name="SlicerParameterName" stdset="0">
            <string>netgenGrading</string>
           </property>
          </widget>
         </item>
         <item row="6" column="0">
          <widget class="QLabel" name="netgenOptimizationStepsLabel">
           <property name="text">
            <string>Netgen optimization steps:</string>
           </property>
           <property name="indent">
            <number>10</number>
           </property>
          </widget>
         </item>
         <item row="6" column="1">
          <widget class="QSpinBox" name="netgenOptimizationStepsSpinBox">
           <property name="toolTip">
            <string>How many passes Netgen spends improving the mesh once it has filled the surface. Netgen only.</string>
           </property>
           <property name="minimum">
            <number>0</number>
           </property>
           <property name="maximum">
            <number>100</number>
           </property>
           <property name="value">
            <number>3</number>
           </property>
           <property name="SlicerParameterName" stdset="0">
            <string>netgenOptimizationSteps</string>
           </property>
          </widget>
         </item>
         <item row="7" column="0">
          <widget class="QLabel" name="tetrahedralizeLabel">
           <property name="text">
            <string>Tetrahedralize:</string>
           </property>
          </widget>
         </item>
         <item row="7" column="1">
          <widget class="QCheckBox" name="tetrahedralizeCheckBox">
           <property name="toolTip">
            <string>Split every prism of the boundary layer into tetrahedra, for a solver that takes nothing else.</string>
           </property>
           <property name="text">
            <string/>
           </property>
           <property name="SlicerParameterName" stdset="0">
            <string>tetrahedralize</string>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QPushButton" name="applyButton">
     <property name="enabled">
      <bool>false</bool>
     </property>
     <property name="toolTip">
      <string>Generate the volume mesh.</string>
     </property>
     <property name="text">
      <string>Apply</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QTextEdit" name="logTextEdit">
     <property name="toolTip">
      <string>What the run says as it goes: each step as it starts and how long it took, what the pipeline warns about, and why it stopped if it did. Cleared when Apply is pressed. The same lines go to the application log.</string>
     </property>
     <property name="readOnly">
      <bool>true</bool>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
