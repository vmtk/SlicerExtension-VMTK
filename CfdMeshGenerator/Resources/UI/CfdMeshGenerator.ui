      </item>
      <item row="5" column="1">
       <widget class="QCheckBox" name="boundaryLayerCheckBox">
        <property name="toolTip">
         <string>Line the wall on the inside with layers of prisms, which is what resolves the velocity gradient at the wall and, with it, the wall shear stress. The rest of the volume is filled with tetrahedra as before.</string>
        </property>
        <property name="text">
         <string/>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>boundaryLayer</string>
