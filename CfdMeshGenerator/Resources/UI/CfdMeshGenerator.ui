       <widget class="QCheckBox" name="capSurfaceCheckBox">
        <property name="toolTip">
         <string>Close every open boundary of the input surface with a cap of its own, each under its own id so that a boundary condition can be assigned to it. Turn this off for a surface that is already closed; a surface left open cannot be filled with tetrahedra at all.</string>
        </property>
        <property name="text">
         <string/>
        </property>
        <property name="checked">
