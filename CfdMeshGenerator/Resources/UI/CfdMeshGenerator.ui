           </property>
          </widget>
         </item>
         <item row="4" column="1">
          <widget class="QDoubleSpinBox" name="endcapsEdgeLengthFactorSpinBox">
           <property name="toolTip">
            <string>Multiplies the target edge length for the caps. It is only read when the boundary layer stops short of the caps, because those caps are the only ones remeshed on their own.</string>
           </property>
           <property name="decimals">
            <number>2</number>
           </property>
           <property name="minimum">
            <double>0.010000000000000</double>
           </property>
