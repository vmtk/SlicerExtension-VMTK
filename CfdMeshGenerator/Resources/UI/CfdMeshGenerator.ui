          <widget class="QLabel" name="numberOfSubstepsLabel">
           <property name="text">
            <string>Number of substeps:</string>
           </property>
           <property name="indent">
            <number>10</number>
           </property>
          </widget>
         </item>
         <item row="5" column="1">
          <widget class="QSpinBox" name="numberOfSubstepsSpinBox">
           <property name="toolTip">
            <string>Steps the inner surface is marched inwards in. More of them let it get around a tight corner without folding over itself, at the cost of time.</string>
           </property>
