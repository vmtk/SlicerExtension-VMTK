         <item row="8" column="1">
          <widget class="QComboBox" name="cappingMethodComboBox">
           <property name="toolTip">
            <string>Shape of the mesh that closes an open boundary. &quot;Simple&quot; fills each boundary on its own, which is what the clipped end of a vessel lumen wants. The annular methods close the ring between an inner and an outer boundary instead, which is the shape the end of a vessel wall of finite thickness has.</string>
           </property>
           <property name="SlicerParameterName" stdset="0">
            <string>cappingMethod</string>
           </property>
          </widget>
         </item>
