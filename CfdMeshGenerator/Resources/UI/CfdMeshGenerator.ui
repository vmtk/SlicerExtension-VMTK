         </item>
         <item row="2" column="1">
          <widget class="QDoubleSpinBox" name="subLayerRatioSpinBox">
           <property name="toolTip">
            <string>Thickness of each layer over the thickness of the one outside it. Below 1 the layers get thinner towards the wall, which is where the gradient is steepest.</string>
           </property>
           <property name="decimals">
            <number>2</number>
           </property>
           <property name="minimum">
            <double>0.010000000000000</double>
           </property>
           <property name="maximum">
            <double>10.000000000000000</double>
           </property>
           <property name="singleStep">
            <double>0.050000000000000</double>
           </property>
           <property name="value">
            <double>0.500000000000000</double>
           </property>
           <property name="SlicerParameterName" stdset="0">
